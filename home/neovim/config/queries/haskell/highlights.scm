;; vim: ft=query
;; extends

;; Top-level function definitions
(haskell
  declarations: (declarations
    (function
      name: (variable) @AlabasterDefinition)))

;; Type signatures
(haskell
  declarations: (declarations
    (signature
      name: (variable) @AlabasterDefinition)))

;; Data type declarations
(haskell
  declarations: (declarations
    (data_type
      name: (name) @AlabasterDefinition)))

;; Type synonyms
(haskell
  declarations: (declarations
    (type_synonym
      name: (name) @AlabasterDefinition)))

;; Newtype declarations
(haskell
  declarations: (declarations
    (newtype
      name: (name) @AlabasterDefinition)))
