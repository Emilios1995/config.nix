# Append to ~/.bashrc on the laptop (Omarchy ships bash).

# mosh reuses the `desk` block in ~/.ssh/config for its ssh handshake, then talks
# UDP directly — that UDP survives lid closes and network changes.
alias desk="mosh --server=/etc/profiles/per-user/emilio/bin/mosh-server desk -- tmux new -A -s main"

# Fallback when anything mosh-specific misbehaves. Omarchy wraps ssh in a
# reconnecting shell function, so this is already fairly resilient on its own.
alias sshdesk="ssh -t desk 'tmux new -A -s main'"
