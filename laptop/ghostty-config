# Ghostty config for the laptop. Copy to ~/.config/ghostty/config.ghostty
#
# Carried over from the Studio's wezterm config (../home/default.nix). What did
# not survive the move is noted at the bottom.
#
# Comments must be on their own line: a trailing # is read as part of the value.

theme = Alabaster

# Copied from ~/Library/Fonts on the Studio — paid font, not installed by any
# package manager. See README step 6.
font-family = PragmataPro Mono Liga
font-size = 15

# wezterm's line_height = 1.5. Ghostty has no line-height; adjust-cell-height is
# a delta, so 50% means "half again taller", not "half as tall".
adjust-cell-height = 50%

# OSC 52 writes, which is how a tmux yank on the desk reaches this machine's
# clipboard. Already the default; set explicitly because the whole remote setup
# depends on it.
clipboard-write = allow

# wezterm's audible_bell = "Disabled". Ghostty defaults to silent on macOS
# anyway; spelled out so a future default change does not surprise us.
bell-features = no-system,no-audio

# wezterm bound CMD|SHIFT+E to a tab-rename prompt. Ghostty has the same thing,
# but ships it unbound.
keybind = cmd+shift+e=prompt_tab_title

# Deliberately left out:
#
# - background image + the CTRL+I toggle. The image lives on the Studio, and
#   Ghostty has no config-level toggle — background-image is static.
# - font-style = Medium. The installed PragmataPro has Regular/Bold/Italic/
#   Oblique and no Medium, so wezterm was falling back to Regular regardless.
# - tab_bar_at_bottom, hide_tab_bar_if_only_one_tab, use_fancy_tab_bar. macOS
#   Ghostty uses native window tabs, which already hide themselves at one tab
#   and cannot be moved. macos-titlebar-style = tabs is the nearest knob.
